<div class="blueprint px-4 py-3.5">
  <%= blueprint_corners %>
  <div class="card-kicker mb-2"><%= side.owner.name %> — bench</div>
  <table class="table">
    <tbody>
      <% side.bench.each do |entry| %>
        <tr>
          <td class="w-16 whitespace-nowrap text-ink/55"><%= player_positions_label(entry.player) %></td>
          <td><%= player_with_team(entry.player) %></td>
          <td class="text-right"><%= points_display(entry.points) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
