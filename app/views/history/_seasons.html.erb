<section>
  <div class="mb-3 flex flex-wrap items-baseline gap-3.5">
    <h2 class="font-heading text-[32px] font-semibold leading-tight tracking-[-0.015em]">Every season</h2>
    <span class="text-xs text-ink/55"><%= history_count_note(@season_records.size, @season_records.size, "season") %></span>
  </div>
  <div class="blueprint px-4 py-3.5">
    <%= blueprint_corners %>
    <div class="overflow-x-auto">
      <table id="history-seasons" class="table min-w-[1000px]">
        <thead>
          <tr>
            <th><%= history_sort_header "Year", "year" %></th>
            <th>League</th>
            <th>Owner</th>
            <th><%= history_sort_header "Finish", "finish" %></th>
            <th><%= history_sort_header "W–L", "win_pct" %></th>
            <th><%= history_sort_header "PF", "pf" %></th>
            <th><%= history_sort_header "PA", "pa" %></th>
            <th><%= history_sort_header "PF/g", "pfg" %></th>
            <th><%= history_sort_header "PA/g", "pag" %></th>
            <th><%= history_sort_header "xW", "xw" %></th>
            <th><%= history_sort_header "Luck", "luck" %></th>
            <th><%= history_sort_header "High", "high" %></th>
            <th><%= history_sort_header "Low", "low" %></th>
          </tr>
        </thead>
        <tbody>
          <% @season_records.each do |record| %>
            <tr>
              <td class="font-medium">
                <%= link_to record.year, season_path(record.year, tier: (record.tier unless record.tier == "unified")),
                      class: "hover:text-accent" %>
              </td>
              <td><span class="tag <%= tier_tag_class(record.tier) %>"><%= tier_label(record.tier) %></span></td>
              <td class="whitespace-nowrap">
                <%= link_to record.owner.name, owner_path(record.owner, season: record.year), class: "font-medium text-accent" %>
                <span class="text-[11px] text-ink/55"><%= record.owner.team_name_in(record.year) %></span>
              </td>
              <td><%= finish_display(record.final_rank) %></td>
              <td><%= record_display(record) %></td>
              <td><%= points_display(record.points_for) %></td>
              <td><%= points_display(record.points_against) %></td>
              <td><%= points_display(record.average_points) %></td>
              <td><%= points_display(record.average_points_against) %></td>
              <td><%= wins_display(record.expected_wins) %></td>
              <td class="font-medium"><%= signed_wins_display(record.all_play_luck) %></td>
              <td class="text-ink/55"><%= points_display(record.highest_score) %></td>
              <td class="text-ink/55"><%= points_display(record.lowest_score) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="mt-2.5 text-[11px] text-ink/55"><%= season_history_note(@almanac) %></div>
  </div>
</section>
