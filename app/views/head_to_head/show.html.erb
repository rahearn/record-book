<% content_for :title, "ATO Delta · Head-to-head" %>
<% content_for :tagline, league_tagline(@almanac) %>

<% if @almanac.empty? %>
  <p class="text-ink/55">No games on record yet.</p>
<% else %>
  <section>
    <%= form_with url: head_to_head_path, method: :get,
          class: "grid grid-cols-[1fr_auto_1fr] items-center gap-4.5",
          data: { controller: "autosubmit" } do |form| %>
      <div>
        <%= form.label :a, "Owner A", for: "owner_a", class: "mb-1 block text-xs text-ink/70" %>
        <%= form.select :a, owner_select_options(@almanac), { selected: @owner_a.id },
              id: "owner_a", class: "input", data: { action: "change->autosubmit#submit" } %>
      </div>
      <div class="font-heading text-xl text-ink/55">VS</div>
      <div>
        <%= form.label :b, "Owner B", for: "owner_b", class: "mb-1 block text-xs text-ink/70" %>
        <%= form.select :b, owner_select_options(@almanac), { selected: @owner_b.id },
              id: "owner_b", class: "input", data: { action: "change->autosubmit#submit" } %>
      </div>
      <noscript><%= form.submit "Compare", class: "btn btn-secondary" %></noscript>
    <% end %>
  </section>

  <section class="blueprint flex flex-wrap items-center justify-center gap-9 px-6 py-6.5">
    <%= blueprint_corners %>
    <div class="min-w-[180px] text-right">
      <div class="card-kicker"><%= @owner_a.team_name %></div>
      <div class="font-heading text-[30px] font-semibold leading-[1.1]"><%= @owner_a.name %></div>
    </div>
    <div class="font-heading text-[66px] font-semibold leading-none tracking-[-0.02em]"><%= series_display(@series) %></div>
    <div class="min-w-[180px]">
      <div class="card-kicker"><%= @owner_b.team_name %></div>
      <div class="font-heading text-[30px] font-semibold leading-[1.1]"><%= @owner_b.name %></div>
    </div>
  </section>

  <section class="blueprint flex flex-col gap-3 px-5 py-4.5">
    <%= blueprint_corners %>
    <% h2h_comparison_rows(@series, @career_a, @career_b).each do |row| %>
      <div class="grid grid-cols-[78px_1fr_130px_1fr_78px] items-center gap-2.5 text-[13px]">
        <span class="text-right font-medium"><%= row.a_display %></span>
        <span class="relative h-2.5 bg-ink/5">
          <span class="absolute inset-y-0 right-0 bg-accent" style="width: <%= row.a_bar %>"></span>
        </span>
        <span class="text-center text-[11px] uppercase tracking-[.08em] text-ink/55"><%= row.label %></span>
        <span class="relative h-2.5 bg-ink/5">
          <span class="absolute inset-y-0 left-0 bg-accent-400" style="width: <%= row.b_bar %>"></span>
        </span>
        <span class="font-medium"><%= row.b_display %></span>
      </div>
    <% end %>
  </section>

  <section>
    <div class="mb-3 flex items-baseline gap-3.5">
      <h2 class="font-heading text-[32px] font-semibold leading-tight tracking-[-0.015em]">Every meeting</h2>
      <span class="text-xs text-ink/55"><%= series_note(@series) %></span>
    </div>
    <% if @series.games_played.zero? %>
      <p class="text-ink/55">No games between these owners are on record.</p>
    <% else %>
      <div class="blueprint px-4 py-3.5">
        <%= blueprint_corners %>
        <div class="overflow-x-auto">
          <table class="table min-w-[620px]">
            <thead>
              <tr>
                <th>Season</th>
                <th>Week</th>
                <th>League</th>
                <th><%= @owner_a.name %></th>
                <th><%= @owner_b.name %></th>
                <th>Margin</th>
                <th>Winner</th>
              </tr>
            </thead>
            <tbody>
              <% @series.meetings.each do |meeting| %>
                <tr id="meeting-<%= meeting.year %>-w<%= meeting.week %>">
                  <td><%= meeting.year %></td>
                  <td class="text-ink/55">W<%= meeting.week %></td>
                  <td><span class="tag <%= tier_tag_class(meeting.tier) %>"><%= tier_label(meeting.tier) %></span></td>
                  <td><%= points_display(meeting.points_a) %></td>
                  <td><%= points_display(meeting.points_b) %></td>
                  <td class="text-ink/55"><%= points_display(meeting.margin) %></td>
                  <td class="font-medium"><%= @series.winner_of(meeting)&.name || "Tie" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </section>
<% end %>
