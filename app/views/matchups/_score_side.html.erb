<div class="flex min-w-0 flex-col gap-0.5 <%= align %>">
  <span class="card-kicker"><%= side.owner.team_name_in(matchup.year) %></span>
  <%= link_to side.owner.name, owner_path(side.owner),
        class: "font-heading text-[26px] font-semibold leading-[1.1] text-accent" %>
  <span class="text-[11px] text-ink/55"><%= season_context_note(side) %></span>
  <span class="font-heading text-[54px] font-semibold leading-none"><%= points_display(side.points) %></span>
  <span class="text-[11px] text-ink/55"><%= bench_note(side) %></span>
</div>
